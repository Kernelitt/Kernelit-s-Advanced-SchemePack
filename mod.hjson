#the mod name as displayed in-game
displayName: "Kernelit's Advanced SchemePack"

#the internal name of your mod
name: "kernelit-advanced-schemepack"

#your name
author: "Kernelit"

#the fully qualified main class of the mod
main: "kernelit.AdvancedSchemePackMod"

#the mod description as seen in the mod dialog
description: "Динамический схемпак для кампании и пвп. Тестовая версия. Много схем взяты с сервера, и ещё не под всё они найдутся. 216 схем на текущий момент"

#the mod version
version: 1.1

#the minimum game build required to run this mod
minGameVersion: 158

#this is a java mod
java: true

hidden: true